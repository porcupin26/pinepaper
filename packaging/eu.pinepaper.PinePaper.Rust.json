{
  "app-id": "eu.pinepaper.PinePaper.Rust",
  "runtime": "org.gnome.Platform",
  "runtime-version": "49",
  "sdk": "org.gnome.Sdk",
  "sdk-extensions": [
    "org.freedesktop.Sdk.Extension.rust-stable"
  ],
  "command": "pinepaper",
  "finish-args": [
    "--socket=wayland",
    "--share=ipc",
    "--share=network",
    "--filesystem=home",
    "--system-talk-name=org.freedesktop.NetworkManager",
    "--talk-name=org.pinenote.PineNoteCtl"
  ],
  "build-options": {
    "append-path": "/usr/lib/sdk/rust-stable/bin",
    "env": {
      "CARGO_HOME": "/run/build/pinepaper/cargo"
    }
  },
  "modules": [
    {
      "name": "poppler-data",
      "buildsystem": "simple",
      "build-commands": [
        "make install prefix=/app"
      ],
      "sources": [
        {
          "type": "archive",
          "url": "https://poppler.freedesktop.org/poppler-data-0.4.12.tar.gz",
          "sha256": "c835b640a40ce357e1b83666aabd95edffa24ddddd49b8daff63adb851cdab74"
        }
      ]
    },
    {
      "name": "poppler",
      "buildsystem": "cmake-ninja",
      "config-opts": [
        "-DENABLE_QT5=OFF",
        "-DENABLE_QT6=OFF",
        "-DENABLE_GLIB=OFF",
        "-DENABLE_CPP=OFF",
        "-DENABLE_UTILS=ON",
        "-DENABLE_LIBCURL=OFF",
        "-DENABLE_NSS3=OFF",
        "-DENABLE_GPGME=OFF",
        "-DENABLE_BOOST=OFF",
        "-DBUILD_GTK_TESTS=OFF",
        "-DBUILD_CPP_TESTS=OFF",
        "-DBUILD_QT5_TESTS=OFF",
        "-DBUILD_QT6_TESTS=OFF",
        "-DBUILD_MANUAL_TESTS=OFF",
        "-DENABLE_UNSTABLE_API_ABI_HEADERS=OFF"
      ],
      "sources": [
        {
          "type": "archive",
          "url": "https://poppler.freedesktop.org/poppler-26.10.0.tar.xz",
          "sha256": "6792cb7c69205007ad87d2e936cecc5b3a31fac29ab54ffc3175fdb6b2a6ce35"
        }
      ]
    },
    {
      "name": "wl-clipboard",
      "buildsystem": "meson",
      "config-opts": ["-Dfishcompletiondir=/app/share/fish/vendor_completions.d"],
      "sources": [
        {
          "type": "archive",
          "url": "https://github.com/bugaevc/wl-clipboard/archive/refs/tags/v2.2.1.tar.gz",
          "sha256": "6eb8081207fb5581d1d82c4bcd9587205a31a3d47bea3ebeb7f41aa1143783eb"
        }
      ]
    },
    {
      "name": "pinepaper",
      "buildsystem": "simple",
      "build-commands": [
        "cargo build --release --locked --offline",
        "PREFIX=/app bash packaging/install.sh target/release/pinepaper"
      ],
      "sources": [
        {
          "type": "dir",
          "path": "source"
        }
      ]
    }
  ]
}
